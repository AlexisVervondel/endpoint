# Copy this file to .env and fill in real values
# Never commit .env

DATABASE_URL=postgresql://user:password@localhost:5432/its_db
NODE_ENV=development
PORT=3000
SESSION_SECRET=change-me-to-a-random-64-char-string

# Incident Tracker (apps/incidents)
INCIDENTS_PORT=3001
INCIDENTS_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5174
LOG_LEVEL=info

# Slack webhook for incident open/close/escalation notifications (optional)
SLACK_WEBHOOK_URL=

# IT Request Tracker (apps/requests)
REQUESTS_PORT=3002
REQUESTS_HOST=0.0.0.0
REQUESTS_CORS_ORIGIN=http://localhost:5175
